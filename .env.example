# Copia este fichero a .env y cambia los valores. .env no se sube al repositorio.
POSTGRES_USER=contabilidad
POSTGRES_PASSWORD=cambia-esta-contraseña
# Clave de firma de las sesiones: cadena aleatoria de 32 caracteres o más (p. ej. openssl rand -base64 48)
JWT_KEY=
# Puertos publicados en tu máquina
DB_PUERTO=5433
API_PUERTO=6579
WEB_PUERTO=6581
# Direcciones tal como las ve el navegador: deben coincidir con los puertos (o con tu dominio)
API_URL=http://localhost:6579
WEB_URL=http://localhost:6581
# true para publicar Swagger en /swagger
SWAGGER=false
