{
  "ConnectionStrings": {
    "Contabilidad": "Host=localhost;Port=5432;Database=contabilidad;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "contabilidad",
    "Audience": "contabilidad-web",
    "Minutos": 480
  },
  "Cors": {
    "Origenes": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.Hosting.Lifetime": "Information" }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/contabilidad-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ]
  },
  "AllowedHosts": "*"
}
